        {
          "$Comment": "=== MODE 4: WORKING (.Default = actively working, .Resting = out of fuel/paused. Both sub-states are set only from Java, never from a JSON Action.) ===",
          "Sensor": {
            "Type": "State",
            "State": "Working"
          },
          "Instructions": [
            {
              "$Comment": "--- .Resting: resting pose (native Kweebec_Sapling 'Rest' flavor animation, Status slot - same PlayAnimation mechanism as Trork's campfire-sit, bytecode-verified via ActionPlayAnimation.execute -> NPCEntity.playAnimation). 'Rest' used instead of 'Sit' - 'Sit' assumes a seat height (furniture), which put Keyleth visually into the ground with no seat present; 'Rest' is the ground-level pose. Hoe put away. Single instruction only - add 'Continue': true here if a second .Resting instruction is ever added below it, same reasoning as the Farm-Loop reorder below. ---",
              "Sensor": {
                "Type": "State",
                "State": ".Resting"
              },
              "BodyMotion": {
                "Type": "Nothing"
              },
              "Actions": [
